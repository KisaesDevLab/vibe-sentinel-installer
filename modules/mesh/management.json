{
  "_comment": "NetBird management config template. Installer fills OIDC values from the Authentik NetBird provider (device flow enabled for headless peers — Phase 6M). Relay stanza intentionally ABSENT: direct-only by default (Decision 17); relay/setup adds it only after failed NAT test + QI consent.",
  "Stuns": [{ "Proto": "udp", "URI": "stun:stun.cloudflare.com:3478" }],
  "TURNConfig": { "Turns": [], "TimeBasedCredentials": false },
  "Signal": { "Proto": "https", "URI": "nb-signal.__SENTINEL_DOMAIN__:443" },
  "HttpConfig": {
    "AuthIssuer": "https://id.__SENTINEL_DOMAIN__/application/o/netbird/",
    "AuthAudience": "netbird",
    "OIDCConfigEndpoint": "https://id.__SENTINEL_DOMAIN__/application/o/netbird/.well-known/openid-configuration"
  },
  "IdpManagerConfig": null,
  "DeviceAuthorizationFlow": {
    "Provider": "hosted",
    "ProviderConfig": {
      "Audience": "netbird",
      "ClientID": "netbird",
      "TokenEndpoint": "https://id.__SENTINEL_DOMAIN__/application/o/token/",
      "DeviceAuthEndpoint": "https://id.__SENTINEL_DOMAIN__/application/o/device/",
      "Scope": "openid profile email offline_access"
    }
  },
  "PKCEAuthorizationFlow": {
    "ProviderConfig": {
      "Audience": "netbird",
      "ClientID": "netbird",
      "AuthorizationEndpoint": "https://id.__SENTINEL_DOMAIN__/application/o/authorize/",
      "TokenEndpoint": "https://id.__SENTINEL_DOMAIN__/application/o/token/",
      "Scope": "openid profile email offline_access",
      "RedirectURLs": ["http://localhost:53000"]
    }
  }
}
