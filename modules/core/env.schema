# modules/core/env.schema — KEY=description:required|optional
SENTINEL_DOMAIN=Firm domain on Cloudflare; all §2.6 hostnames hang under it:required
SENTINEL_MODULES_DIR=Staged module directory (/etc/vibe-sentinel/modules):required
SENTINEL_DATA_DIR=Host data root (/var/lib/vibe-sentinel):required
MESH_BIND_IP=Mesh interface IP for agent/ntfy port bindings (127.0.0.1 until mesh is up):required
POSTGRES_USER=Postgres superuser for the shared instance:required
POSTGRES_PASSWORD=Postgres password (also materialized as docker secret pg_password):required
AUTHENTIK_SECRET_KEY=Authentik Django secret key:required
AUTHENTIK_BOOTSTRAP_PASSWORD=Initial QI admin password (sealed after first login):required
AUTHENTIK_BOOTSTRAP_TOKEN=Bootstrap API token used by installer automation:required
AUTHENTIK_BOOTSTRAP_EMAIL=QI email — becomes the Authentik admin login:required
SMTP_HOST=Firm SMTP relay host (preflight-verified):required
SMTP_PORT=SMTP port (587 STARTTLS / 465 TLS):required
SMTP_USERNAME=SMTP username:optional
SMTP_FROM=From address for Sentinel/Authentik/Vaultwarden mail:required
WAZUH_API_PASSWORD=Wazuh API + indexer admin password:required
WAZUH_ENROLLMENT_PASSWORD=Agent enrollment password baked into Lite bundles:required
SENTINEL_API_SECRET=Sentinel API signing secret:required
SENTINEL_AI_MODE=local | cloud_optin (Decision 8):required
RESTIC_PASSWORD=Built-in backup repository password (profile no-vault):required
RESTIC_REPOSITORY=Restic repository path or B2 URL (profile no-vault):required
BACKUP_WINDOW=Daily backup window HH:MM-HH:MM:required
TZ=Firm timezone:optional
