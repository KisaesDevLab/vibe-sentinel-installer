# modules/ai/env.schema — KEY=description:required|optional
#
# The ai module ships no container, so it contributes no compose services and
# no image. It needs exactly one thing from the environment: which mode the
# firm chose. Everything else lives in config.json and is rendered into
# /etc/vibe-sentinel/ai/router-client.json by setup.sh.
SENTINEL_AI_MODE=local | cloud_optin — local vibellm by default; cloud Anthropic is opt-in and metadata-only (Decision 8):required
